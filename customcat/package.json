{
  "name": "@absolutejs/commerce-customcat",
  "version": "0.6.20-beta.2",
  "description": "CustomCat print-on-demand fulfillment adapter for @absolutejs/commerce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/commerce-adapters.git",
    "directory": "customcat"
  },
  "homepage": "https://github.com/absolutejs/commerce-adapters/tree/main/customcat",
  "bugs": {
    "url": "https://github.com/absolutejs/commerce-adapters/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "license": "Apache-2.0",
  "author": "Alex Kahn",
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts ./src/manifest.ts --root ./src --outdir dist --target bun --external @absolutejs/commerce --external '@absolutejs/commerce/*' --external @absolutejs/execution --external '@absolutejs/execution/*' --external @absolutejs/manifest --external @sinclair/typebox && tsc --emitDeclarationOnly --project tsconfig.json && absolute-manifest emit",
    "format": "prettier --write \"./**/*.{js,ts,json,md}\"",
    "release": "bun run check:package && npm publish --access public --tag beta",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify-package": "absolute-manifest verify-package",
    "check:package": "bun run format && bun run typecheck && bun run test && bun run verify-package && bun run build"
  },
  "dependencies": {
    "@absolutejs/manifest": "0.9.0",
    "@sinclair/typebox": "0.34.52"
  },
  "peerDependencies": {
    "@absolutejs/commerce": ">=0.40.1-beta.1 <0.41",
    "@absolutejs/execution": ">=0.14.6 <0.15"
  },
  "devDependencies": {
    "@absolutejs/commerce": "0.40.1-beta.5",
    "@absolutejs/execution": "0.14.6",
    "@types/bun": "1.3.14",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "absolutejs": {
    "manifestContract": 2
  }
}
